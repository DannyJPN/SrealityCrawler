# PostgreSQL Database Configuration
POSTGRES_DB=reality_history
POSTGRES_USER=sreality
POSTGRES_PASSWORD=sreality

# Timezone
TZ=Europe/Prague

# Flask Configuration
FLASK_APP=app.main:app
FLASK_ENV=production

# Crawler Configuration (optional overrides)
# DOWNLOAD_DELAY=0.1
# RETRY_TIMES=100
# DOWNLOAD_TIMEOUT=30

# Debugpy (set to 1 for step-by-step debugging)
# CRAWLER_DEBUGPY_ENABLE=1
# CRAWLER_DEBUGPY_WAIT=1
# CRAWLER_DEBUGPY_PORT=5678
# FLASK_DEBUGPY_ENABLE=1
# FLASK_DEBUGPY_WAIT=1
# FLASK_DEBUGPY_PORT=5679
