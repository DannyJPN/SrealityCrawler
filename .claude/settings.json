      "List(**)",
      "Search(**)",
      "Read(./**)",
      "Read(H:/**)",
      "Read(F:/**)",
      "Read(L:/**)",
      "Read(M:/**)",
      "Read(N:/**)",

      "Bash(python -m venv:*)",
      "Bash(.*[\\\\/]?venv[\\\\/].*[\\\\/](python|python\\.exe):*)",
      "Bash(.*[\\\\/]?venv[\\\\/].*[\\\\/](pip|pip\\.exe) install:*)",

      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",

      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh repo view:*)",

      "Bash(git checkout -b claude/*:*)",
      "Bash(git switch -c claude/*:*)",

      "Bash(ping:*)",
      "Bash(iconv:*)",
      "Bash(sort:*)",
      "Bash(gh issue create:*)",

      "Bash(powershell.exe -NoProfile -Command \"Stop-Process -Name 'Dropbox'*:*)",
      "Bash(powershell.exe -Command \"Get-Process -Name 'Dropbox'*:*)",
      "Bash(powershell.exe -NoProfile -Command \"Start-Process -FilePath*Dropbox*:*)",

      "Bash(scrapy startproject:*)",
      "Bash(scrapy genspider:*)",
      "Bash(scrapy crawl:*)",
      "Bash(scrapy list:*)",
      "Bash(scrapy settings:*)",
      "Bash(scrapy check:*)",
      "Bash(scrapy shell:*)",

      "Bash(flask --app*:*)",
      "Bash(flask run:*)",
      "Bash(flask shell:*)",

      "Bash(docker compose up:*)",
      "Bash(docker compose down:*)",
      "Bash(docker compose build:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose exec:*)",
      "Bash(docker compose run:*)",

      "Bash(psql:*)",
      "Bash(createdb:*)",
      "Bash(pg_dump:*)",
      "Bash(pg_restore:*)",

      "Read(//f/tmp/claude/**)",

      "WebSearch",

      "WebFetch(domain:docs.python.org)",
      "WebFetch(domain:pypi.org)",
      "WebFetch(domain:pip.pypa.io)",
      "WebFetch(domain:docs.scrapy.org)",
      "WebFetch(domain:scrapy.org)",
      "WebFetch(domain:flask.palletsprojects.com)",
      "WebFetch(domain:jinja.palletsprojects.com)",
      "WebFetch(domain:sqlalchemy.org)",
      "WebFetch(domain:www.postgresql.org)",
      "WebFetch(domain:postgresql.org)",
      "WebFetch(domain:psycopg.org)",
      "WebFetch(domain:apscheduler.readthedocs.io)",
      "WebFetch(domain:sreality.cz)",
      "WebFetch(domain:www.sreality.cz)",
      "WebFetch(domain:lxml.de)",
      "WebFetch(domain:requests.readthedocs.io)",
      "WebFetch(domain:docs.docker.com)",

      "WebFetch(domain:openai.com)",
      "WebFetch(domain:platform.openai.com)",
      "WebFetch(domain:api.openai.com)",
      "WebFetch(domain:anthropic.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:mistral.ai)",
      "WebFetch(domain:api.mistral.ai)",
      "WebFetch(domain:ai.google.dev)",
      "WebFetch(domain:developers.google.com)",
      "WebFetch(domain:ai.meta.com)",
      "WebFetch(domain:llama.meta.com)",
      "WebFetch(domain:huggingface.co)",
      "WebFetch(domain:docs.huggingface.co)"

    ],
    "ask": [
      "Write(./**)",
      "Edit(./**)",
      "Delete(./**)",
      "Update(./**)",

      "Bash(python *.py:*)",
      "Bash(pytest:*)",
      "Bash(coverage:*)",
      "Bash(ruff:*)",
      "Bash(black:*)",
      "Bash(mypy:*)",

      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git rebase:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git tag:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",

      "Bash(start:*)",
      "Bash(.*/[^\\\\/]*(\\.exe|\\.bat|\\.cmd):*)"
    ],
    "deny": [
      "Read(C:/**)",

      "Write(/**)",
      "Edit(/**)",
      "Delete(/**)",

      "Bash(git merge:*)",

      "Bash(taskkill:*)",
      "Bash(kill:*)",

      "WebFetch(domain:localhost)",
      "WebFetch(domain:127.0.0.1)",
      "WebFetch(domain:0.0.0.0)"
    ]
  },

  "branchPolicy": {
    "claudeBranchPattern": "claude/*",
    "gitAutoWithoutAsk": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)"
    ],
    "respectUserBranches": true
  },

  "additionalDirectories": [
    ".."
  ],

  "statusLine": {
    "type": "text",
    "text": "SrealityCrawler Project"
  },

  "dropboxManagement": {
    "stopCommand": "powershell.exe -NoProfile -Command \"Stop-Process -Name 'Dropbox' -Force -ErrorAction SilentlyContinue; Start-Sleep -Seconds 2\"",
    "startCommand": "powershell.exe -NoProfile -Command \"Start-Process -FilePath 'C:\\Program Files (x86)\\Dropbox\\Client\\Dropbox.exe'\"",
    "checkCommand": "powershell.exe -Command \"Get-Process -Name 'Dropbox' -ErrorAction SilentlyContinue\"",
    "note": "Always stop Dropbox BEFORE git operations (add/commit/push) to avoid permission denied errors in .git/objects/"
  }
}